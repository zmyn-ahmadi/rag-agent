# Chat LLM (OpenAI-compatible, e.g. llama-server)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=none
LLM_MODEL=local

# Embedding model (OpenAI-compatible)
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=none

# Postgres + pgvector
DATABASE_URL=postgresql+psycopg://user@localhost/agent_memory_db

# Valkey (session cache)
VALKEY_HOST=localhost
VALKEY_PORT=6379
